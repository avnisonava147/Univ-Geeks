# Hostinger Apache / LiteSpeed Configuration for Univ-Geeks Static Website

# Explicitly declare index.html so LiteSpeed serves it for any directory
DirectoryIndex index.html index.php

# Disable directory browsing for security, allow following symlinks
Options -Indexes +FollowSymLinks -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pass Authorization Header for JWT Tokens
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # 1. If direct file exists (JS, CSS, PDF, images, icons, etc.), serve it directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2. If a directory is requested without trailing slash, redirect with 301 to add trailing slash
  # This preserves query parameters like ?chapter=Real%20Numbers and triggers DirectoryIndex
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,QSA,L]

  # 3. If directory has index.html, serve it directly and preserve query string
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}index.html -f [OR]
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]

  # 4. If direct .html exists for clean URL (e.g. /about -> /about.html), serve it
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*?)/?$ /$1.html [QSA,L]

  # 5. Fallback for non-existent routes -> Next.js 404 page
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /404.html [L]
</IfModule>

# Caching for fast load times
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>
