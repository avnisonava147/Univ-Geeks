# Server Port
PORT=8080

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/univgeeks

# Allowed Origins for CORS (comma-separated)
CORS_ALLOWED_ORIGINS=https://univsvh.in,https://www.univsvh.in,https://univgeeks.in,https://www.univgeeks.in,https://univgeeks.com,https://www.univgeeks.com,http://localhost:3000,http://127.0.0.1:3000

# Initial Admin Bootstrap Account (Required on initial setup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_EMAIL=admin@univgeeks.in

# JWT Secret Key (min 32 characters recommended)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_at_least_32_chars

# ImageKit Cloud Storage Configuration
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key_here
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/eguapakpx
